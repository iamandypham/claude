d": 34.94}, {"w": "who", "start": 34.94, "end": 35.16}, {"w": "have", "start": 35.16, "end": 35.34}, {"w": "less.", "start": 35.34, "end": 35.66}]}, {"start": 36.02, "end": 37.92, "text": "What does that build in you? It builds gratitude.", "words": [{"w": "What", "start": 36.02, "end": 36.12}, {"w": "does", "start": 36.12, "end": 36.26}, {"w": "that", "start": 36.26, "end": 36.44}, {"w": "build", "start": 36.44, "end": 36.72}, {"w": "in", "start": 36.72, "end": 36.92}, {"w": "you?", "start": 36.92, "end": 37.04}, {"w": "It", "start": 37.14, "end": 37.14}, {"w": "builds", "start": 37.14, "end": 37.36}, {"w": "gratitude.", "start": 37.36, "end": 37.92}]}, {"start": 38.3, "end": 41.4, "text": "Most people nowadays are so kind of resentful", "words": [{"w": "Most", "start": 38.3, "end": 38.44}, {"w": "people", "start": 38.44, "end": 38.7}, {"w": "nowadays", "start": 38.7, "end": 39.1}, {"w": "are", "start": 39.1, "end": 39.5}, {"w": "so", "start": 39.5, "end": 40.18}, {"w": "kind", "start": 40.18, "end": 40.6}, {"w": "of", "start": 40.6, "end": 40.72}, {"w": "resentful", "start": 40.72, "end": 41.4}]}, {"start": 41.4, "end": 43.16, "text": "about everything else they don't have.", "words": [{"w": "about", "start": 41.4, "end": 41.6}, {"w": "everything", "start": 41.6, "end": 41.98}, {"w": "else", "start": 41.98, "end": 42.34}, {"w": "they", "start": 42.34, "end": 42.5}, {"w": "don't", "start": 42.5, "end": 42.86}, {"w": "have.", "start": 42.86, "end": 43.16}]}, {"start": 43.5, "end": 46.16, "text": "I want you to build this emotion of gratitude", "words": [{"w": "I", "start": 43.5, "end": 43.62}, {"w": "want", "start": 43.62, "end": 43.8}, {"w": "you", "start": 43.8, "end": 43.96}, {"w": "to", "start": 43.96, "end": 44.06}, {"w": "build", "start": 44.06, "end": 44.38}, {"w": "this", "start": 44.38, "end": 44.88}, {"w": "emotion", "start": 44.88, "end": 45.4}, {"w": "of", "start": 45.4, "end": 45.6}, {"w": "gratitude", "start": 45.6, "end": 46.16}]}, {"start": 46.16, "e