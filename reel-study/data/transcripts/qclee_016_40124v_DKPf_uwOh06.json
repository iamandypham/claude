w": "wanna", "start": 82.48, "end": 82.56}, {"w": "be", "start": 82.56, "end": 82.72}, {"w": "self", "start": 82.72, "end": 83.0}, {"w": "-made.", "start": 83.0, "end": 83.24}]}, {"start": 83.36, "end": 84.9, "text": "I wanna make up all my own strategies.", "words": [{"w": "I", "start": 83.36, "end": 83.4}, {"w": "wanna", "start": 83.4, "end": 83.54}, {"w": "make", "start": 83.54, "end": 83.72}, {"w": "up", "start": 83.72, "end": 83.92}, {"w": "all", "start": 83.92, "end": 84.3}, {"w": "my", "start": 84.3, "end": 84.44}, {"w": "own", "start": 84.44, "end": 84.6}, {"w": "strategies.", "start": 84.6, "end": 84.9}]}, {"start": 85.04, "end": 86.42, "text": "I wanna do all this stuff by myself", "words": [{"w": "I", "start": 85.04, "end": 85.08}, {"w": "wanna", "start": 85.08, "end": 85.18}, {"w": "do", "start": 85.18, "end": 85.3}, {"w": "all", "start": 85.3, "end": 85.46}, {"w": "this", "start": 85.46, "end": 85.58}, {"w": "stuff", "start": 85.58, "end": 85.82}, {"w": "by", "start": 85.82, "end": 86.0}, {"w": "myself", "start": 86.0, "end": 86.42}]}, {"start": 86.42, "end": 88.64, "text": "when people already have paved the way for you", "words": [{"w": "when", "start": 86.42, "end": 86.64}, {"w": "people", "start": 86.64, "end": 86.9}, {"w": "already", "start": 86.9, "end": 87.3}, {"w": "have", "start": 87.3, "end": 87.52}, {"w": "paved", "start": 87.52, "end": 87.78}, {"w": "the", "start": 87.78, "end": 87.98}, {"w": "way", "start": 87.98, "end": 88.12}, {"w": "for", "start": 88.12, "end": 88.36}, {"w": "you", "start": 88.36, "end": 88.64}]}, {"start": 88.64, "end": 90.06, "text": "and have mastered the craft.", "words": [{"w": "and", "start": 88.64, "end": 89.06}, {"w": "have", "start": 89.06, "end": 89.18}, {"w": "mastered", "start": 89.18, "end": 89.56}, {"w": "the", "start": 89.56, "end": 89.78}, {"w": "craft.", "start": 89.78, "end": 90.06}]}, {"start": 90.94, "end": 92.58, "text": "The literal gap between where you are now", "words": [{"w": "The", "start": 90.94, "end": 90.96}, {"w": "literal", "start": 90.96, "end": 91.22}, {"w": "gap", "start": 91.22, "end": 91.52}, {"w": "between", "start": 91.52, "end": 91.8}, {"w": "where", "start": 91.8, "end": 92.0}, {"w": "you", "start": 92.0, "end": 92.18}, {"w": "are", "start": 92.18, "end": 92.32}, {"w": "now", "start": 92.32, "end": 92.58}]}, {"start": 92.58, "end": 93.84, "text": "and where you wanna be in life", "words": [{"w": "and", "start": 92.58, "end": 92.78}, {"w": "where", "start": 92.78, "end": 92.98}, {"w": "you", "start": 92.98, "end": 93.1}, {"w": "wanna", "start": 93.1, "end": 93.24}, {"w": "be", "start": 93.24, "end": 93.46}, {"w": "in", "start": 93.46, "end": 93.62}, {"w": "life", "start": 93.62, "end": 93.84}]}, {"start": 93.84, "end": 96.72, "text": "is just information and the implementation of it.", "words": [{"w": "is", "start": 93.84, "end": 94.16}, {"w": "just", "start": 94.16, "end": 94.36}, {"w": "information", "start": 94.36, "end": 94.88}, {"w": "and", "start": 94.88, "end": 95.58}, {"w": "the", "start": 95.58, "end": 95.68}, {"w": "implementation", "start": 95.68, "end": 96.12}, {"w": "of", "start": 96.12, "end": 96.58}, {"w": "it.", "start": 96.58, "end": 96.72}]}, {"start": 97.1, "end": 99.04, "text": "And highly intelligent people understand", "words": [{"w": "And", "start": 97.1, "end": 97.22}, {"w": "highly", "start": 97.22, "end": 97.5}, {"w": "intelligent", "start": 97.5, "end": 97.92}, {"w": "people", "start": 97.92, "end": 98.32}, {"w": "understand", "start": 98.32, "end": 99.04}]}, {"start": 99.04, "end": 100.52, "text": "this principle greatly, okay?", "words": [{"w": "this", "start": 99.04, "end": 99.34}, {"w": "principle", "start": 99.34, "end": 99.74}, {"w": "greatly,", "start": 99.74, "end": 100.14}, {"w": "okay?", "start": 100.44, "end": 100.52}]}, {"start": 100.92, "end": 102.2, "text": "Socrates mentioned Plato,", "words": [{"w": "Socrates", "start": 100.92, "end": 101.4}, {"w": "mentioned", "start": 101.4, "end": 101.86}, {"w": "Plato,", "start": 101.86, "end": 102.2}]}, {"start": 102.74, "end": 105.12, "text": "Plato mentored Aristotle and so on.", "words": [{"w": "Plato", "start": 102.74, "end": 103.08}, {"w": "mentored", "start": 103.08, "end": 103.46}, {"w": "Aristotle", "start": 103.46, "end": 104.0}, {"w": "and", "start": 104.0, "end": 104.3}, {"w": "so", "start": 104.3, "end": 104.64}, {"w": "on.", "start": 104.64, "end": 105.12}]}, {"start": 105.62, "end": 107.46, "text": "Because they understand that anything they want", "words": [{"w": "Because", "start": 105.62, "end": 105.82}, {"w": "they", "start": 105.82, "end": 106.04}, {"w": "understand", "start": 106.04, "end": 106.56}, {"w": "that", "start": 106.56, "end": 106.76}, {"w": "anything", "start": 106.76, "end": 107.0}, {"w": "they", "start": 107.0, "end": 107.24}, {"w": "want", "start": 107.24, "end": 107.46}]}, {"start": 107.46, "end": 108.3, "text": "to achieve in life,", "words": [{"w": "to", "start": 107.46, "end": 107.64}, {"w": "achieve", "start": 107.64, "end": 107.96}, {"w": "in", "start": 107.96, "end": 108.12}, {"w": "life,", "start": 108.12, "end": 108.3}]}, {"start": 108.46, "end": 110.84, "text": "somebody already knows and understands how to do it.", "words": [{"w": "somebody", "start": 108.46, "end": 108.74}, {"w": "already", "start": 108.74, "end": 109.16}, {"w": "knows", "start": 109.16, "end": 109.52}, {"w": "and", "start": 109.52, "end": 109.72}, {"w": "understands", "start": 109.72, "end": 110.08}, {"w": "how", "start": 110.08, "end": 110.4}, {"w": "to", "start": 110.4, "end": 110.48}, {"w": "do", "start": 110.48, "end": 110.7}, {"w": "it.", "start": 110.7, "end": 110.84}]}, {"start": 111.02, "end": 113.5, "text": "And all they have to do is go learn from them.", "words": [{"w": "And", "start": 111.02, "end": 111.16}, {"w": "all", "start": 111.16, "end": 111.32}, {"w": "they", "start": 111.32, "end": 111.46}, {"w": "have", "start": 111.46, "end": 111.66}, {"w": "to", "start": 111.66, "end": 111.78}, {"w": "do", "start": 111.78, "end": 111.98}, {"w": "is", "start": 111.98, "end": 112.14}, {"w": "go", "start": 112.14, "end": 112.36}, {"w": "learn", "start": 112.36, "end": 112.72}, {"w": "from", "start": 112.72, "end": 113.06}, {"w": "them.", "start": 113.06, "end": 113.5}]}, {"start": 113.94, "end": 115.96, "text": "And furthermore, they understand that time", "words": [{"w": "And", "start": 113.94, "end": 114.14}, {"w": "furthermore,", "start": 114.14, "end": 114.66}, {"w": "they", "start": 114.76, "end": 114.98}, {"w": "understand", "start": 114.98, "end": 115.42}, {"w": "that", "start": 115.42, "end": 115.64}, {"w": "time", "start": 115.64, "end": 115.96}]}, {"start": 115.96, "end": 117.94, "text": "is the most valuable asset on earth.", "words": [{"w": "is", "start": 115.96, "end": 116.2}, {"w": "the", "start": 116.2, "end": 116.32}, {"w": "most", "start": 116.32, "end": 116.54}, {"w": "valuable", "start": 116.54, "end": 116.96}, {"w": "asset", "start": 116.96, "end": 117.38}, {"w": "on", "start": 117.38, "end": 117.68}, {"w": "earth.", "start": 117.68, "end": 117.94}]}, {"start": 118.06, "end": 118.82, "text": "It's the only asset.", "words": [{"w": "It's", "start": 118.06, "end": 118.1}, {"w": "the", "start": 118.1, "end": 118.26}, {"w": "only", "start": 118.26, "end": 118.46}, {"w": "asset.", "start": 118.46, "end": 118.82}]}, {"start": 119.24, "end": 122.14, "text": "Once it's gone, you cannot get it back, okay?", "words": [{"w": "Once", "start": 119.24, "end": 119.4}, {"w": "it's", "start": 119.4, "end": 119.64}, {"w": "gone,", "start": 119.64, "end": 119.84}, {"w": "you", "start": 120.18, "end": 120.32}, {"w": "cannot", "start": 120.32, "end": 120.72}, {"w": "get", "start": 120.72, "end": 121.14}, {"w": "it", "start": 121.14, "end": 121.5}, {"w": "back,", "start": 121.5, "end": 121.84}, {"w": "okay?", "start": 121.96, "end": 122.14}]}, {"start": 122.26, "end": 123.8, "text": "So these people are not wasting time", "words": [{"w": "So", "start": 122.26, "end": 122.32}, {"w": "these", "start": 122.32, "end": 122.48}, {"w": "people", "start": 122.48, "end": 122.72}, {"w": "are", "start": 122.72, "end": 122.86}, {"w": "not", "start": 122.86, "end": 123.1}, {"w": "wasting", "start": 123.1, "end": 123.4}, {"w": "time", "start": 123.4, "end": 123.8}]}, {"start": 123.8, "end": 125.52, "text": "trying to make up their own strategies,", "words": [{"w": "trying", "start": 123.8, "end": 124.24}, {"w": "to", "start": 124.24, "end": 124.34}, {"w": "make", "start": 124.34, "end": 124.64}, {"w": "up", "start": 124.64, "end": 124.8}, {"w": "their", "start": 124.8, "end": 124.92}, {"w": "own", "start": 124.92, "end": 125.08}, {"w": "strategies,", "start": 125.08, "end": 125.52}]}, {"start": 125.7, "end": 127.88, "text": "make up their own way, pay their own way, okay?", "words": [{"w": "make", "start": 125.7, "end": 125.88}, {"w": "up", "start": 125.88, "end": 126.04}, {"w": "their", "start": 126.04, "end": 126.16}, {"w": "own", "start": 126.16, "end": 126.4}, {"w": "way,", "start": 126.4, "end": 126.64}, {"w": "pay", "start": 126.8, "end": 126.94}, {"w": "their", "start": 126.94, "end": 127.1}, {"w": "own", "start": 127.1, "end": 127.32}, {"w": "way,", "start": 127.32, "end": 127.56}, {"w": "okay?", "start": 127.72, "end": 127.88}]}, {"start": 128.24, "end": 130.48, "text": "Just to satisfy their own egos, okay?", "words": [{"w": "Just", "start": 128.24, "end": 128.38}, {"w": "to", "start": 128.38, "end": 128.5}, {"w": "satisfy", "start": 128.5, "end": 128.94}, {"w": "their", "start": 128.94, "end": 129.38}, {"w": "own", "start": 129.38, "end": 129.72}, {"w": "egos,", "start": 129.72, "end": 130.18}, {"w": "okay?", "start": 130.34, "end": 130.48}]}, {"start": 130.6, "end": 132.98, "text": "They're going to find the person that they need to find", "words": [{"w": "They're", "start": 130.6, "end": 130.72}, {"w": "going", "start": 130.72, "end": 131.02}, {"w": "to", "start": 131.02, "end": 131.24}, {"w": "find", "start": 131.24, "end": 131.5