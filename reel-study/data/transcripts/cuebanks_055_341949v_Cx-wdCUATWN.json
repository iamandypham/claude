{"file": "cuebanks_055_341949v_Cx-wdCUATWN.mp4", "language": "en", "segments": [{"start": 0.18, "end": 2.72, "text": "It's important for me to understand the state of mind", "words": [{"w": "It's", "start": 0.18, "end": 0.58}, {"w": "important", "start": 0.58, "end": 0.68}, {"w": "for", "start": 0.68, "end": 0.9}, {"w": "me", "start": 0.9, "end": 0.94}, {"w": "to", "start": 0.94, "end": 1.08}, {"w": "understand", "start": 1.08, "end": 1.68}, {"w": "the", "start": 1.68, "end": 2.0}, {"w": "state", "start": 2.0, "end": 2.14}, {"w": "of", "start": 2.14, "end": 2.28}, {"w": "mind", "start": 2.28, "end": 2.72}]}, {"start": 2.72, "end": 4.48, "text": "and the life you live", "words": [{"w": "and", "start": 2.72, "end": 3.52}, {"w": "the", "start": 3.52, "end": 3.64}, {"w": "life", "start": 3.64, "end": 3.86}, {"w": "you", "start": 3.86, "end": 4.1}, {"w": "live", "start": 4.1, "end": 4.48}]}, {"start": 5.02, "end": 7.58, "text": "and wear your, you know, wear your rat right now.", "words": [{"w": "and", "start": 5.02, "end": 5.24}, {"w": "wear", "start": 5.24, "end": 5.76}, {"w": "your,", "start": 5.76, "end": 5.98}, {"w": "you", "start": 6.04, "end": 6.26}, {"w": "know,", "start": 6.26, "end": 6.34}, {"w": "wear", "start": 6.38, "end": 6.54}, {"w": "your", "start": 6.54, "end": 6.7}, {"w": "rat", "start": 6.7, "end": 6.92}, {"w": "right", "start": 6.92, "end": 7.14}, {"w": "now.", "start": 7.14, "end": 7.58}]}, {"start": 7.86, "end": 10.2, "text": "If you're like, like me, you know what I'm saying?", "words": [{"w": "If", "start": 7.86, "end": 8.18}, {"w": "you're", "start": 8.18, "end": 8.36}, {"w": "like,", "start": 8.36, "end": 8.5}, {"w": "like", "start": 8.74, "end": 8.9}, {"w": "me,", "start": 8.9, "end": 9.42}, {"w": "you", "start": 9.74, "end": 9.92}, {"w": "know", "start": 9.92, "end": 9.96}, {"w": "what", "start": 9.96, "end": 10.06}, {"w": "I'm", "start": 10.06, "end": 10.18}, {"w": "saying?", "start": 10.18, "end": 10.2}]}, {"start": 10.56, "end": 11.06, "tex