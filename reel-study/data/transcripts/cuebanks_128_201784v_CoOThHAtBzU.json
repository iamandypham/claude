{"file": "cuebanks_128_201784v_CoOThHAtBzU.mp4", "language": "en", "segments": [{"start": 0.0, "end": 0.7, "text": "Believe in yourself.", "words": [{"w": "Believe", "start": 0.0, "end": 0.26}, {"w": "in", "start": 0.26, "end": 0.4}, {"w": "yourself.", "start": 0.4, "end": 0.7}]}, {"start": 1.36, "end": 3.12, "text": "Have faith in your abilities.", "words": [{"w": "Have", "start": 1.36, "end": 1.88}, {"w": "faith", "start": 1.88, "end": 2.18}, {"w": "in", "start": 2.18, "end": 2.56}, {"w": "your", "start": 2.56, "end": 2.7}, {"w": "abilities.", "start": 2.7, "end": 3.12}]}, {"start": 3.92, "end": 5.24, "text": "Know that there's something inside you", "words": [{"w": "Know", "start": 3.92, "end": 4.04}, {"w": "that", "start": 4.04, "end": 4.22}, {"w": "there's", "start": 4.22, "end": 4.44}, {"w": "something", "start": 4.44, "end": 4.66}, {"w": "inside", "start": 4.66, "end": 5.06}, {"w": "you", "start": 5.06, "end": 5.24}]}, {"start": 5.24, "end": 6.62, "text": "that is greater than any obstacle.", "words": [{"w": "that", "start": 5.24, "end": 5.38}, {"w": "is", "start": 5.38, "end": 5.52}, {"w": "greater", "start": 5.52, "end": 5.74}, {"w": "than", "start": 5.74, "end": 5.94}, {"w": "any", "start": 5.94, "end": 6.26}, {"w": "obstacle.", "start": 6.26, "end": 6.62}]}, {"start": 7.54, "end": 10.52, "text": "Trust yourself, your instincts and your experiences.", "words": [{"w": "Trust", "start": 7.54, "end": 7.78}, {"w": "yourself,", "start": 7.78, "end": 8.28}, {"w": "your", "start": 8.78, "end": 8.88}, {"w": "instincts", "start": 8.88, "end": 9.26}, {"w": "and", "start": 9.26, "end": 9.84}, {"w": "your", "start": 9.84, "end": 9.96}, {"w": "experiences.", "start": 9.96, "end": 10.52}]}, {"start": 11.26, "end": 13.3, "text": "Embrace the power of positive thinking", "words": [{"w": "Embrace", "start": 11.26, "end": 11.7}, {"w": "the", "start": 11.7, "end": 11.84}, {"w": "power", "start": 11.84, "end": 12.14}, {"w": "of", "start": 12.14, "end": 12.4}, {"w": "positive"