{"file": "tori.trades_045_580312v_DP7SZ15jKDy.mp4", "language": "en", "segments": [{"start": 0.0, "end": 1.6, "text": "People ask, is she single?", "words": [{"w": "People", "start": 0.0, "end": 0.22}, {"w": "ask,", "start": 0.22, "end": 0.64}, {"w": "is", "start": 0.88, "end": 1.08}, {"w": "she", "start": 1.08, "end": 1.26}, {"w": "single?", "start": 1.26, "end": 1.6}]}, {"start": 2.16, "end": 2.8, "text": "Is she married?", "words": [{"w": "Is", "start": 2.16, "end": 2.32}, {"w": "she", "start": 2.32, "end": 2.44}, {"w": "married?", "start": 2.44, "end": 2.8}]}, {"start": 3.14, "end": 3.66, "text": "She's got a boyfriend.", "words": [{"w": "She's", "start": 3.14, "end": 3.3}, {"w": "got", "start": 3.3, "end": 3.44}, {"w": "a", "start": 3.44, "end": 3.48}, {"w": "boyfriend.", "start": 3.48, "end": 3.66}]}, {"start": 4.14, "end": 4.5, "text": "You got a number?", "words": [{"w": "You", "start": 4.14, "end": 4.2}, {"w": "got", "start": 4.2, "end": 4.3}, {"w": "a", "start": 4.3, "end": 4.36}, {"w": "number?", "start": 4.36, "end": 4.5}]}, {"start": 4.82, "end": 5.32, "text": "Can I have it?", "words": [{"w": "Can", "start": 4.82, "end": 4.96}, {"w": "I", "start": 4.96, "end": 5.04}, {"w": "have", "start": 5.04, "end": 5.18}, {"w": "it?", "start": 5.18, "end": 5.32}]}, {"start": 5.58, "end": 6.44, "text": "I'm single, everyone.", "words": [{"w": "I'm", "start": 5.58, "end": 5.74}, {"w": "single,", "start": 5.74, "end": 6.06}, {"w": "everyone.", "start": 6.24, "end": 6.44}]}, {"start": 7.12, "end": 7.82, "text": "I am.", "words": [{"w": "I", "start": 7.12, "end": 7.5}, {"w": "am.", "start": 7.5, "end": 7.82}]}, {"start": 8.16, "end": 11.46, "text": "Am I probably gonna turn into a 30-year-old cat lady", "words": [{"w": "Am", "start": 8.16, "end": 8.32}, {"w": "I", "start": 8.32, "end": 8.44}, {"w": "probably", "start": 8.44, "end": 8.8}, {"w": "gonna", "start": 8.8, "end": 9.04}, {"w": "turn", "start": 9.04, "end": 9.28}, {"w": "into", "start": 9.28, "end": 9.58}, {"w": "a", "start": 9.58, "end": 9.92}, {"w": "30", "start": 9.92, "end": 10.36}, {"w": "-year", "start": 10.36, "end": 10.54}, {"w": "-old", "start": 10.54, "end": 10.72}, {"w": "cat", "start": 10.72, "end": 11.14}, {"w": "lady", "start": 11.14, "end": 11.46}]}, {"start": 11.46, "end": 14.26, "text": "with no family, no husband?", "words": [{"w": "with", "start": 11.46, "end": 12.02}, {"w": "no", "start": 12.02, "end": 12.68}, {"w": "family,", "start": 12.68, "end": 13.06}, {"w": "no", "start": 13.62, "end": 13.94}, {"w": "husband?", "start": 13.94, "end": 14.26}]}, {"start": 14.8, "end": 15.12, "text": "Maybe.", "words": [{"w": "Maybe.", "start": 14.8, "end": 15.12}]}, {"start": 15.52, "end": 18.14, "text": "I'll be honest, I'm just waiting on somebody extraordinary.", "words": [{"w": "I'll", "start": 15.52, "end": 15.72}, {"w": "be", "start": 15.72, "end": 15.88}, {"w": "honest,", "start": 15.88, "end": 16.06}, {"w": "I'm", "start": 16.18, "end": 16.28}, {"w": "just", "start": 16.28, "end": 16.46}, {"w": "waiting", "start": 16.46, "end": 16.8}, {"w": "on", "start": 16.8, "end": 17.0}, {"w": "somebody", "start": 17.0, "end": 17.38}, {"w": "extraordinary.", "start": 17.38, "end": 18.14}]}, {"start": 19.1, "end": 20.06, "text": "Absolutely extraordinary.", "words": [{"w": "Absolutely", "start": 19.1, "end": 19.58}, {"w": "extraordinary.", "start": 19.58, "end": 20.06}]}, {"start": 20.62, "end": 22.26, "text": "And I will not settle for less.", "words": [{"w": "And", "start": 20.62, "end": 20.8}, {"w": "I", "start": 20.8, "end": 20.92}, {"w": "will", "start": 20.92, "end": 21.08}, {"w": "not", "start": 21.08, "end": 21.34}, {"w": "settle", "start": 21.34, "end": 21.74}, {"w": "for", "start": 21.74, "end": 22.0}, {"w": "less.", "start": 22.0, "end": 22.26}]}, {"start": 22.68, "end": 24.08, "text": "Don't settle for less than you deserve.", "words": [{"w": "Don't", "start": 22.68, "end": 22.98}, {"w": "settle", "start": 22.98, "end": 23.22}, {"w": "for", "start": 23.22, "end": 23.42}, {"w": "less", "start": 23.42, "end": 23.6}, {"w": "than", "start": 23.6, "end": 23.76}, {"w": "you", "start": 23.76, "end": 23.84}, {"w": "deserve.", "start": 23.84, "end": 24.08}]}, {"start": 24.46, "end": 25.72, "text": "Morgan and Morgan taught me that.", "words": [{"w": "Morgan", "start": 24.46, "end": 24.8}, {"w": "and", "start": 24.8, "end": 24.92}, {"w": "Morgan", "start": 24.92, "end": 25.1}, {"w": "taught", "start": 25.1, "end": 25.36}, {"w": "me", "start": 25.36, "end": 25.5}, {"w": "that.", "start": 25.5, "end": 25.72}]}, {"start": 26.1, "end": 26.94, "text": "I don't know, guys.", "words": [{"w": "I", "start": 26.1, "end": 26.24}, {"w": "don't", "start": 26.24, "end": 26.36}, {"w": "know,", "start": 26.36, "end": 26.58}, {"w": "guys.", "start": 26.68, "end": 26.94}]}, {"start": 27.16, "end": 27.68, "text": "Like, I don't know.", "words": [{"w": "Like,", "start": 27.16, "end": 27.22}, {"w": "I", "start": 27.24, "end": 27.32}, {"w": "don't", "start": 27.32, "end": 27.42}, {"w": "know.", "start": 27.42, "end": 27.68}]}, {"start": 28.06, "end": 29.44, "text": "I set the bar really high.", "words": [{"w": "I", "start": 28.06, "end": 28.16}, {"w": "set", "start": 28.16, "end": 28.36}, {"w": "the", "start": 28.36, "end": 28.48}, {"w": "bar", "start": 28.48, "end": 28.68}, {"w": "really", "start": 28.68, "end": 29.06}, {"w": "high.", "start": 29.06, "end": 29.44}]}, {"start": 29.44, "end": 31.92, "text": "I've set the bar really high.", "words": [{"w": "I've", "start": 29.44, "end": 30.02}, {"w": "set", "start": 30.02, "end": 30.26}, {"w": "the", "start": 30.26, "end": 30.46}, {"w": "bar", "start": 30.46, "end": 30.78}, {"w": "really", "start": 30.78, "end": 31.38}, {"w": "high.", "start": 31.38, "end": 31.92}]}, {"start": 32.26, "end": 33.88, "text": "I still won't be taken care of.", "words": [{"w": "I", "start": 32.26, "end": 32.6}, {"w": "still", "start": 32.6, "end": 32.78}, {"w": "won't", "start": 32.78, "end": 33.04}, {"w": "be", "start": 33.04, "end": 33.06}, {"w": "taken", "start": 33.06, "end": 33.26}, {"w": "care", "start": 33.26, "end": 33.54}, {"w": "of.", "start": 33.54, "end": 33.88}]}, {"start": 34.18, "end": 36.28, "text": "I still want Daddy to bring in the bales.", "words": [{"w": "I", "start": 34.18, "end": 34.38}, {"w": "still", "start": 34.38, "end": 34.58}, {"w": "want", "start": 34.58, "end": 34.76}, {"w": "Daddy", "start": 34.76, "end": 35.04}, {"w": "to", "start": 35.04, "end": 35.2}, {"w": "bring", "start": 35.2, "end": 35.34}, {"w": "in", "start": 35.34, "end": 35.48}, {"w": "the", "start": 35.48, "end": 35.58}, {"w": "bales.", "start": 35.58, "end": 36.28}]}, {"start": 36.4, "end": 38.54, "text": "I just, I've set the bar very high.", "words": [{"w": "I", "start": 36.4, "end": 36.58}, {"w": "just,", "start": 36.58, "end": 36.78}, {"w": "I've", "start": 36.96, "end": 37.5}, {"w": "set", "start": 37.5, "end": 37.66}, {"w": "the", "start": 37.66, "end": 37.78}, {"w": "bar", "start": 37.78, "end": 37.94}, {"w": "very", "start": 37.94, "end": 38.18}, {"w": "high.", "start": 38.18, "end": 38.54}]}, {"start": 39.28, "end": 41.62, "text": "So in order for someone to meet me where I am,", "words": [{"w": "So", "start": 39.28, "end": 39.52}, {"w": "in", "start": 39.52, "end": 39.72}, {"w": "order", "start": 39.72, "end": 39.94}, {"w": "for", "start": 39.94, "end": 40.12}, {"w": "someone", "start": 40.12, "end": 40.36}, {"w": "to", "start": 40.36, "end": 40.56}, {"w": "meet", "start": 40.56, "end": 40.8}, {"w": "me", "start": 40.8, "end": 41.0}, {"w": "where", "start": 41.0, "end": 41.24}, {"w": "I", "start": 41.24, "end": 41.44}, {"w": "am,", "start": 41.44, "end": 41.62}]}, {"start": 41.7, "end": 42.88, "text": "they have to be extraordinary.", "words": [{"w": "they", "start": 41.7, "end": 41.78}, {"w": "have", "start": 41.78, "end": 41.98}, {"w": "to", "start": 41.98, "end": 42.1}, {"w": "be", "start": 42.1, "end": 42.32}, {"w": "extraordinary.", "start": 42.32, "end": 42.88}]}, {"start": 43.54, "end": 45.36, "text": "So that is where I'm at", "words": [{"w": "So", "start": 43.54, "end": 43.62}, {"w": "that", "start": 43.62, "end": 44.46}, {"w": "is", "start": 44.46, "end": 44.64}, {"w": "where", "start": 44.64, "end": 44.86}, {"w": "I'm", "start": 44.86, "end": 45.1}, {"w": "at", "start": 45.1, "end": 45.36}]}, {"start": 45.36, "end": 48.6, "text": "in the pursuit of finding somebody.", "words": [{"w": "in", "start": 45.36, "end": 45.84}, {"w": "the", "start": 45.84, "end": 46.06}, {"w": "pursuit", "start": 46.06, "end": 46.54}, {"w": "of", "start": 46.54, "end": 47.04}, {"w": "finding", "start": 47.04, "end": 47.86}, {"w": "somebody.", "start": 47.86, "end": 48.6}]}, {"start": 48.88, "end": 49.96, "text": "Thanks for joining my TED Talk.", "words": [{"w": "Thanks", "start": 48.88, "end": 49.02}, {"w": "for", "start": 49.02, "end": 49.24}, {"w": "joining", "start": 49.24, "end": 49.46}, {"w": "my", "start": 49.46, "end": 49.62}, {"w": "TED", "start": 49.62, "end": 49.74}, {"w": "Talk.", "start": 49.74, "end": 49.96}]}]}